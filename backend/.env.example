# Server Configuration
PORT=4000
NODE_ENV=development

# OpenAI API for translation
OPENAI_API_KEY=XXX

# Azure Speech (speech-to-text) credentials
# Note: despite the MARKITDOWN_ prefix, these are the key and region of your Azure Speech resource
MARKITDOWN_API_KEY=XXX
MARKITDOWN_REGION=eastus

# Optional: yt-dlp settings for when YouTube blocks the server's IP ("Sign in to confirm you're not a bot")
# Proxy URL, e.g. a residential proxy: http://user:pass@host:port
YTDLP_PROXY=
# Contents of a Netscape-format cookies.txt (raw or base64-encoded)
YTDLP_COOKIES=

# File paths
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
TEMP_DIR=temp

# Optional: only needed if yt-dlp / ffmpeg are not on your PATH
# (on Windows, the download step reads YT_DLP_BINARY_LOCAL instead of YT_DLP_BINARY)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# YT_DLP_BINARY=/opt/homebrew/bin/yt-dlp
# YT_DLP_BINARY_LOCAL=C:\path\to\yt-dlp.exe
